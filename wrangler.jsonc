// Cloudflare Worker that serves the static export in ./out.
// worker/index.ts runs first for /hub/* only (Business hub reports); everything else is plain static assets.
// Deploy: `npm run deploy` (needs `npx wrangler login` once, or CLOUDFLARE_API_TOKEN).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "still-frog-528a",
  "account_id": "6aa82ebe1e7dfd8fb8504ea052a21fea",
  "compatibility_date": "2026-10-22",
  "main": "worker/index.ts",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": ["/hub/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Serve the Business hub reports straight from main on GitHub, so a merged daily update
  // shows within GitHub's 5-minute cache instead of waiting for a rebuild. The Worker falls
  // back to the bundled copy in public/hub/ if GitHub can't be reached.
  "vars": { "HUB_SOURCE": "https://raw.githubusercontent.com/KhangaiDe/test1235/main/public/hub" }
}
